{
  "name": "@fishtvue/monorepo",
  "description": "A monorepo setup for managing multiple FishTVue related packages and applications.",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "author": "Egor Bondarenko",
  "license": "ISC",
  "homepage": "https://www.fisht.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Egoka/FishtVue.git"
  },
  "bugs": {
    "url": "https://github.com/Egoka/FishtVue/issues"
  },
  "keywords": [
    "fishtvue",
    "vue",
    "vue.js",
    "vue3",
    "ui",
    "ui library",
    "component library"
  ],
  "scripts": {
    "doc:build": "pnpm --filter doc build",
    "doc:dev": "pnpm --filter doc dev",
    "doc:generate": "pnpm --filter doc generate",
    "doc:preview": "pnpm --filter doc preview",
    "sandbox:dev": "pnpm --filter sandbox dev",
    "sandbox:build": "pnpm --filter sandbox build",
    "sandbox:preview": "pnpm --filter sandbox preview",
    "lib:build": "cd lib && NODE_ENV=production rollup -c",
    "pack": "cd dist && npm pack --pack-destination='../'",
    "format": "prettier --write \"**/*.{js,ts,vue,d.ts}\" --cache",
    "format:check": "prettier --check \"**/*.{js,ts,vue,d.ts}\"",
    "lint": "eslint --fix .",
    "lint:fix": "eslint --fix --ext \".js,.ts,.vue\" --ignore-pattern .gitignore .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --ui",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "husky:init": "husky"
  },
  "engines": {
    "node": ">=20.18 <25",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.7",
    "@babel/preset-env": "^7.25.7",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.25.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-terser": "^0.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/lodash": "^4.17.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-istanbul": "2.1.8",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.6.0",
    "child-shell": "^5.0.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vue": "^10.0.1",
    "fs-extra": "^11.2.0",
    "husky": "^9.1.6",
    "jsdom": "^24.1.3",
    "path": "^0.12.7",
    "postcss": "^8.4.47",
    "postcss-preset-env": "^9.6.0",
    "postcss-selector-parser": "^6.1.2",
    "prettier": "^3.7.1",
    "resize-observer-polyfill": "^1.5.1",
    "rollup": "^4.53.3",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "semantic-release": "^24.2.0",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.5"
  },
  "optionalDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.3"
  },
  "dependencies": {
    "@heroicons/vue": "^2.1.5",
    "@iconify/vue": "^4.1.2",
    "@nuxt/kit": "^3.17.3",
    "@nuxt/schema": "^3.15.4",
    "@popperjs/core": "^2.11.8",
    "@vueup/vue-quill": "^1.2.0",
    "csstype": "^3.1.3",
    "date-fns": "^4.1.0",
    "gsap": "^3.12.5",
    "lodash-es": "^4.17.21",
    "nuxt": "^3.0.0",
    "quill": "^2.0.2",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.25"
  }
}
